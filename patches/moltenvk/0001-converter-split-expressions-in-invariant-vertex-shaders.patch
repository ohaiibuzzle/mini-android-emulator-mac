+// Whether any OpDecorate or OpMemberDecorate in the module marks something Invariant.
+static bool hasInvariantDecoration(const vector<uint32_t>& spirv) {
+	for (size_t i = 5; i < spirv.size(); i += max<uint32_t>(spirv[i] >> 16, 1)) {
+		uint32_t op = spirv[i] & 0xFFFF, len = spirv[i] >> 16;
+		if (op == OpDecorate && len >= 3 && i + 2 < spirv.size() && spirv[i + 2] == DecorationInvariant) { return true; }
+		if (op == OpMemberDecorate && len >= 4 && i + 3 < spirv.size() && spirv[i + 3] == DecorationInvariant) { return true; }
+	}
+	return false;
+}
