@@ -129,6 +139,7 @@ void *qemu_memfd_alloc(const char *name, size_t size, unsigned int seals,
             ftruncate(mfd, size) == -1) {
             goto err;
         }
+#endif
     }
 
     ptr = mmap(0, size, PROT_READ | PROT_WRITE, MAP_SHARED, mfd, 0);
