--- a/util/memfd.c
+++ b/util/memfd.c
@@ -117,6 +117,16 @@ void *qemu_memfd_alloc(const char *name, size_t size, unsigned int seals,
     }
 
     if (mfd == -1) {
+#ifdef CONFIG_DARWIN
+        /*
+         * No memfd on macOS, and a temporary file's dirty pages are written
