     if (mfd == -1) {
+#ifdef CONFIG_DARWIN
+        /*
+         * No memfd on macOS. A temporary file's dirty pages are written
+         * back to disk, which for display surfaces is every frame;
+         * POSIX shared memory stays in RAM. The name only lives until
+         * shm_unlink and must fit PSHMNAMLEN (31).
+         */
+        static uint32_t serial;
+        gchar *fname = g_strdup_printf("/qemu-%d-%u", (int)getpid(),
+                                       qatomic_fetch_inc(&serial));
+
+        mfd = shm_open(fname, O_RDWR | O_CREAT | O_EXCL, 0600);
+        shm_unlink(fname);
+        g_free(fname);
