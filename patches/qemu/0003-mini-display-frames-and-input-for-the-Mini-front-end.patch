index 0000000..f4ce67c
--- /dev/null
+++ b/ui/mini.c
@@ -0,0 +1,356 @@
+/*
+ * mini-display: hands the first graphic console to the Mini front-end.
+ *
+ *   -object mini-display,id=mini,chardev=<socket chardev>,shm=</name>
+ *
+ * Mini creates the POSIX shared memory object </name> (a file's pages would
+ * keep being written back to disk) holding two RGBX frames of up to
+ * <side>x<side>, side being the longer screen edge, and connects to the
+ * chardev. On every guest flush the scanout goes into the frame Mini isn't
+ * showing and a FrameMsg names it, with the rotation Mini turns it by. With
+ * gfxstream the GPU copies it there; otherwise (host GLES, another format)
+ * the console surface, read back from the GPU, is. Mini sends InputMsgs back: touch
+ * in panel pixels (to the virtio multitouch screen), pointer motion (to the
+ * virtio mouse), Linux or macOS key codes, evdev events for the
+ * virtio-gamepad (Mini ends each batch with EV_SYN), and the device
+ * rotation, which also tilts the android-vsock accelerometer so the guest
+ * reorients.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qom/object_interfaces.h"
+#include "qom/object.h"
+#include "system/system.h"
+#include "chardev/char-fe.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "hw/virtio/virtio-input.h"
+#include "hw/virtio/virtio-gpu.h"
+#include <dlfcn.h>
+#include <sys/mman.h>
+
+#define TYPE_MINI_DISPLAY "mini-display"
+OBJECT_DECLARE_SIMPLE_TYPE(MiniDisplay, MINI_DISPLAY)
+
+typedef struct FrameMsg {
+    uint32_t width, height;
+    uint32_t rotation;  /* quarter turns counter-clockwise, as Mini's SkinRotation */
+    uint32_t buffer;    /* 0 or 1: which half of the shm file */
+} FrameMsg;
+
+enum { MSG_TOUCH = 1, MSG_KEY = 2, MSG_MAC_KEY = 3, MSG_ROTATE = 4, MSG_POINTER = 5, MSG_PAD = 6 };
+
+typedef struct InputMsg {
+    uint8_t type;
+    int8_t arg;       /* touch: finger (slot); pointer: wheel notches, + is up; pad: evdev type */
+    uint8_t pad[2];
+    int32_t a, b, c;  /* touch: x, y, down; pointer: dx, dy, buttons; key: code, down; rotate: degrees;
+                         pad: evdev code, value */
+} InputMsg;
+
+struct MiniDisplay {
+    Object parent_obj;
+    char *chardev, *shm;
+
+    CharFrontend chr;
+    DisplayChangeListener dcl;
+    Notifier init_done;
+    uint8_t *map;
+    size_t map_size;
+    uint32_t buffer, rotation;
+    struct touch_slot slots[INPUT_EVENT_SLOTS_MAX];
+    uint32_t buttons;   /* the mouse's, as MSG_POINTER's bits */
+    const char *routed; /* the input device QEMU's button events go to */
+    InputMsg in;
+    size_t in_len;
+    FrameMsg out;       /* a FrameMsg the socket took only part of */
+    size_t out_sent;    /* bytes of it already sent; sizeof(out) when none pending */
+};
+
+/*
+ * Messages are fixed-size and the socket is non-blocking: finish a partly
+ * sent one before anything else, or Mini's framing slips for good. Until
+ * then frames are skipped rather than block the main loop. False: still pending.
+ */
+static bool mini_flush_pending(MiniDisplay *s)
+{
+    if (s->out_sent < sizeof(s->out)) {
+        int n = qemu_chr_fe_write(&s->chr, (uint8_t *)&s->out + s->out_sent,
+                                  sizeof(s->out) - s->out_sent);
+        s->out_sent += MAX(n, 0);
+    }
+    return s->out_sent == sizeof(s->out);
+}
+
+static void mini_send(MiniDisplay *s, uint32_t width, uint32_t height)
+{
+    s->out = (FrameMsg){ width, height, s->rotation & 3, s->buffer };
+    int n = qemu_chr_fe_write(&s->chr, (uint8_t *)&s->out, sizeof(s->out));
+    s->out_sent = n > 0 ? n : sizeof(s->out);  /* nothing sent: the frame is just dropped */
+}
+
+static void mini_update(DisplayChangeListener *dcl, int x, int y, int w, int h)
+{
+    MiniDisplay *s = container_of(dcl, MiniDisplay, dcl);
+    DisplaySurface *surf = qemu_console_surface(dcl->con);
+
+    /* Flips pass through QEMU's "Display output is not active" placeholder. */
+    if (!surf || surface_is_placeholder(surf) || !qemu_chr_fe_backend_open(&s->chr) ||
+        !mini_flush_pending(s)) {
+        return;
+    }
+    int pw = surface_width(surf), ph = surface_height(surf);
+    size_t half = s->map_size / 2;
+    if ((size_t)pw * ph * 4 > half) {
+        return;
+    }
+    s->buffer ^= 1;
+    pixman_image_t *dst = pixman_image_create_bits(PIXMAN_a8b8g8r8, pw, ph,
+        (uint32_t *)(s->map + s->buffer * half), pw * 4);
+    pixman_image_composite(PIXMAN_OP_SRC, surf->image, NULL, dst, 0, 0, 0, 0, 0, 0, pw, ph);
+    pixman_image_unref(dst);
+    mini_send(s, pw, ph);
+}
+
+/* gfxstream's GPU copy into host memory, if this gfxstream has it. */
+static int (*mini_gpu_copy)(uint32_t resource_id, void *base, uint64_t size, uint64_t offset);
+static MiniDisplay *mini_gpu_display;
+
+/* The guest flushed its scanout resource: copy it on the GPU, no readback. */
+static bool mini_scanout(uint32_t resource_id, uint32_t width, uint32_t height)
+{
+    MiniDisplay *s = mini_gpu_display;
+    size_t half = s->map_size / 2;
+
+    if (!mini_gpu_copy || !qemu_chr_fe_backend_open(&s->chr) ||
+        (size_t)width * height * 4 > half) {
+        return false;
+    }
+    if (!mini_flush_pending(s)) {
+        return true;  /* dropped, as mini_update does */
+    }
+    if (mini_gpu_copy(resource_id, s->map, s->map_size, (s->buffer ^ 1) * half)) {
+        mini_gpu_copy = NULL;  /* host GLES, another format or no import: that holds all run */
+        return false;
+    }
+    s->buffer ^= 1;
+    mini_send(s, width, height);
+    return true;
+}
+
+/* A new surface is empty until the guest's next flush, which sends it. */
+static void mini_switch(DisplayChangeListener *dcl, DisplaySurface *surf)
+{
+}
+
+static void mini_refresh(DisplayChangeListener *dcl)
+{
+    qemu_console_hw_update(dcl->con);
+}
+
+static const DisplayChangeListenerOps mini_ops = {
+    .dpy_name = "mini",
+    .dpy_refresh = mini_refresh,
+    .dpy_gfx_update = mini_update,
+    .dpy_gfx_switch = mini_switch,
+};
+
+/*
+ * The mouse and the multitouch screen both take button events, and QEMU
+ * hands those to whichever input device was activated last: activate the
+ * one this message is for.
+ */
+static void mini_route(MiniDisplay *s, const char *type)
+{
+    Object *o = s->routed == type ? NULL : object_resolve_type_unambiguous(type, NULL);
+
+    if (o && VIRTIO_INPUT_HID(o)->hs) {
+        qemu_input_handler_activate(VIRTIO_INPUT_HID(o)->hs);
+        s->routed = type;
+    }
+}
+
+static void mini_input(MiniDisplay *s, const InputMsg *msg)
+{
+    QemuConsole *con = s->dcl.con;
+    DisplaySurface *surf = qemu_console_surface(con);
+
+    switch (msg->type) {
+    case MSG_TOUCH: {
+        if (!surf || msg->arg < 0 || msg->arg >= INPUT_EVENT_SLOTS_MAX) {
+            break;
+        }
+        bool touching = s->slots[msg->arg].tracking_id != -1;
+        if (!msg->c && !touching) {
+            break;
+        }
+        mini_route(s, TYPE_VIRTIO_MULTITOUCH);
+        qemu_input_touch_event(con, s->slots, msg->arg, surface_width(surf), surface_height(surf),
+                               msg->a, msg->b,
+                               !msg->c ? INPUT_MULTI_TOUCH_TYPE_END :
+                               touching ? INPUT_MULTI_TOUCH_TYPE_UPDATE :
+                               INPUT_MULTI_TOUCH_TYPE_BEGIN, NULL);
+        break;
+    }
+    case MSG_POINTER: {
+        static uint32_t bits[INPUT_BUTTON__MAX] = {
+            [INPUT_BUTTON_LEFT] = 1, [INPUT_BUTTON_RIGHT] = 2, [INPUT_BUTTON_MIDDLE] = 4,
+            [INPUT_BUTTON_SIDE] = 8, [INPUT_BUTTON_EXTRA] = 16,
+        };
+        mini_route(s, TYPE_VIRTIO_MOUSE);
+        qemu_input_queue_rel(con, INPUT_AXIS_X, msg->a);
+        qemu_input_queue_rel(con, INPUT_AXIS_Y, msg->b);
+        qemu_input_update_buttons(con, bits, s->buttons, msg->c);
+        s->buttons = msg->c;
+        /* The virtio mouse turns a wheel button press into one REL_WHEEL notch. */
+        for (int i = 0; i < abs(msg->arg); i++) {
+            InputButton wheel = msg->arg > 0 ? INPUT_BUTTON_WHEEL_UP : INPUT_BUTTON_WHEEL_DOWN;
+            qemu_input_queue_btn(con, wheel, true);
+            qemu_input_queue_btn(con, wheel, false);
+        }
+        qemu_input_event_sync();
+        break;
+    }
+    case MSG_MAC_KEY:
+        if ((guint)msg->a < qemu_input_map_osx_to_linux_len) {
+            qemu_input_event_send_key_linux(con, qemu_input_map_osx_to_linux[msg->a], msg->b);
+        }
+        break;
+    case MSG_KEY:
+        qemu_input_event_send_key_linux(con, msg->a, msg->b);
+        break;
+    case MSG_PAD: {
+        Object *pad = object_resolve_type_unambiguous("virtio-gamepad-device", NULL);
+        if (pad) {
+            virtio_input_event e = {
+                cpu_to_le16((uint8_t)msg->arg), cpu_to_le16(msg->a), cpu_to_le32(msg->b)
+            };
+            virtio_input_send(VIRTIO_INPUT(pad), &e);
+        }
+        break;
+    }
+    case MSG_ROTATE: {
+        s->rotation = ((msg->a / 90) % 4 + 4) % 4;
+        Object *vsock = object_resolve_type_unambiguous("android-vsock-device", NULL);
+        if (vsock) {
+            object_property_set_uint(vsock, "rotation", s->rotation * 90, NULL);
+        }
+        /* Frames aren't turned here: the last one, named again, turns in Mini. */
+        if (s->out.width && qemu_chr_fe_backend_open(&s->chr) && mini_flush_pending(s)) {
+            mini_send(s, s->out.width, s->out.height);
+        }
+        break;
+    }
+    }
+}
+
+static int mini_can_read(void *opaque)
+{
+    MiniDisplay *s = opaque;
+    return sizeof(s->in) - s->in_len;
+}
+
+static void mini_read(void *opaque, const uint8_t *buf, int size)
+{
+    MiniDisplay *s = opaque;
+
+    memcpy((uint8_t *)&s->in + s->in_len, buf, size);
+    s->in_len += size;
+    if (s->in_len == sizeof(s->in)) {
+        s->in_len = 0;
+        mini_input(s, &s->in);
+    }
+}
+
+static void mini_event(void *opaque, QEMUChrEvent event)
+{
+    MiniDisplay *s = opaque;
+
+    if (event == CHR_EVENT_OPENED) {
+        DisplaySurface *surf = qemu_console_surface(s->dcl.con);
+        s->in_len = 0;
+        s->out_sent = sizeof(s->out);
+        if (surf) {  /* first frame right away */
+            mini_update(&s->dcl, 0, 0, surface_width(surf), surface_height(surf));
+        }
+    }
+}
+
+/* Consoles exist only once the machine is built. */
+static void mini_init_done(Notifier *n, void *data)
+{
+    MiniDisplay *s = container_of(n, MiniDisplay, init_done);
+
+    qemu_console_register_listener(qemu_console_lookup_by_index(0), &s->dcl, &mini_ops);
+}
+
+static void mini_complete(UserCreatable *uc, Error **errp)
+{
+    MiniDisplay *s = MINI_DISPLAY(uc);
+    Chardev *chr = s->chardev ? qemu_chr_find(s->chardev) : NULL;
+
+    if (!chr || !s->shm) {
+        error_setg(errp, "mini-display needs chardev= and shm=");
+        return;
+    }
+    int fd = shm_open(s->shm, O_RDWR, 0);
+    struct stat st;
+    if (fd < 0 || fstat(fd, &st) < 0) {
+        error_setg_errno(errp, errno, "mini-display: cannot open %s", s->shm);
+        if (fd >= 0) {
+            close(fd);
+        }
+        return;
+    }
+    s->map_size = st.st_size;
+    s->map = mmap(NULL, s->map_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (s->map == MAP_FAILED) {
+        s->map = NULL;
+        error_setg_errno(errp, errno, "mini-display: cannot map %s", s->shm);
+        return;
+    }
+    for (int i = 0; i < INPUT_EVENT_SLOTS_MAX; i++) {
+        s->slots[i].tracking_id = -1;
+    }
+    s->out_sent = sizeof(s->out);
+    if (!qemu_chr_fe_init(&s->chr, chr, errp)) {
+        return;
+    }
+    qemu_chr_fe_set_handlers(&s->chr, mini_can_read, mini_read, mini_event, NULL, s, NULL, true);
+    mini_gpu_copy = dlsym(RTLD_DEFAULT, "stream_renderer_mini_scanout");
+    mini_gpu_display = s;
+    virtio_gpu_rutabaga_scanout = mini_scanout;
+    s->init_done.notify = mini_init_done;
+    qemu_add_machine_init_done_notifier(&s->init_done);
+}
+
+static char *mini_get_chardev(Object *o, Error **e) { return g_strdup(MINI_DISPLAY(o)->chardev); }
+static void mini_set_chardev(Object *o, const char *v, Error **e) { MINI_DISPLAY(o)->chardev = g_strdup(v); }
+static char *mini_get_shm(Object *o, Error **e) { return g_strdup(MINI_DISPLAY(o)->shm); }
+static void mini_set_shm(Object *o, const char *v, Error **e) { MINI_DISPLAY(o)->shm = g_strdup(v); }
+
+static void mini_class_init(ObjectClass *oc, const void *data)
+{
+    USER_CREATABLE_CLASS(oc)->complete = mini_complete;
+    object_class_property_add_str(oc, "chardev", mini_get_chardev, mini_set_chardev);
+    object_class_property_add_str(oc, "shm", mini_get_shm, mini_set_shm);
+}
+
+static const TypeInfo mini_info = {
+    .name = TYPE_MINI_DISPLAY,
+    .parent = TYPE_OBJECT,
+    .instance_size = sizeof(MiniDisplay),
+    .class_init = mini_class_init,
+    .interfaces = (const InterfaceInfo[]) { { TYPE_USER_CREATABLE }, { } },
+};
+
+static void mini_register(void)
+{
+    type_register_static(&mini_info);
+}
+
+type_init(mini_register)
