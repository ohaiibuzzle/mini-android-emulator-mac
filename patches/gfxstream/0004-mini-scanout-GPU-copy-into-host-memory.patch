+bool VkEmulation::readColorBufferToHostMemory(uint32_t colorBufferHandle, void* base,
+                                              uint64_t size, uint64_t offset) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    auto vk = mDvk;
+    if (!mDeviceInfo.supportsExternalMemoryHostProps) {
+        return false;
+    }
+    auto colorBufferInfo = gfxstream::base::find(mColorBuffers, colorBufferHandle);
+    if (!colorBufferInfo || !colorBufferInfo->image ||
+        colorBufferInfo->vulkanMode != VulkanMode::VulkanOnly) {
+        return false;  // a GL-backed ColorBuffer's latest pixels may be GL's
+    }
+    const VkFormat format = colorBufferInfo->imageCreateInfoShallow.format;
+    if (format != VK_FORMAT_R8G8B8A8_UNORM && format != VK_FORMAT_R8G8B8A8_SRGB) {
+        return false;
+    }
+    const VkExtent3D extent = colorBufferInfo->imageCreateInfoShallow.extent;
+    if (offset + (uint64_t)extent.width * extent.height * 4 > size) {
+        return false;
+    }
+
+    if (mHostImport.mBase != base || mHostImport.mSize != size) {
+        destroyHostImportLocked();
+        VkMemoryHostPointerPropertiesEXT hostProps = {
+            .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+        };
+        if (vk->vkGetMemoryHostPointerPropertiesEXT(
+                mDevice, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, base,
+                &hostProps) != VK_SUCCESS) {
+            return false;
+        }
+        const VkExternalMemoryBufferCreateInfo externalInfo = {
+            .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+            .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+        };
+        const VkBufferCreateInfo bufferInfo = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .pNext = &externalInfo,
+            .size = size,
+            .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        };
+        if (vk->vkCreateBuffer(mDevice, &bufferInfo, nullptr, &mHostImport.mBuffer) != VK_SUCCESS) {
+            return false;
+        }
+        VkMemoryRequirements requirements;
+        vk->vkGetBufferMemoryRequirements(mDevice, mHostImport.mBuffer, &requirements);
+        const uint32_t typeBits = requirements.memoryTypeBits & hostProps.memoryTypeBits;
+        const VkImportMemoryHostPointerInfoEXT importInfo = {
+            .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+            .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+            .pHostPointer = base,
+        };
+        const VkMemoryAllocateInfo allocInfo = {
+            .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+            .pNext = &importInfo,
+            .allocationSize = size,
+            .memoryTypeIndex = typeBits ? (uint32_t)__builtin_ctz(typeBits) : 0,
+        };
+        if (!typeBits ||
+            vk->vkAllocateMemory(mDevice, &allocInfo, nullptr, &mHostImport.mMemory) != VK_SUCCESS ||
+            vk->vkBindBufferMemory(mDevice, mHostImport.mBuffer, mHostImport.mMemory, 0) !=
+                VK_SUCCESS) {
+            GFXSTREAM_ERROR("Mini: could not import frame memory, falling back to readback.");
+            destroyHostImportLocked();
+            return false;
+        }
+        mHostImport.mBase = base;
+        mHostImport.mSize = size;
+    }
+
+    return readColorBufferToBytesLocked(colorBufferHandle, 0, 0, extent.width, extent.height,
+                                        nullptr, size - offset, mHostImport.mBuffer, offset);
+}
