+int VirtioGpuFrontend::miniScanout(int resId, void* base, uint64_t size, uint64_t offset) {
+    auto it = mResources.find(resId);
+    if (it == mResources.end()) {
+        return EINVAL;
+    }
+    auto handle = it->second.GetColorBufferHandle();
+    if (!handle || !FrameBuffer::getFB()->readColorBufferToHostMemory(*handle, base, size, offset)) {
+        return EINVAL;
+    }
+    return 0;
+}
